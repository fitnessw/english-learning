#!/bin/sh
set -eu

if [ "$#" -lt 1 ]; then
  echo "Usage: AGENT_TOOL=Codex AGENT_MODEL='GPT-5' scripts/agent-commit 'message'" >&2
  exit 2
fi

message=$1
agent_tool=${AGENT_TOOL:-unknown}

if [ -z "${AGENT_MODEL:-}" ]; then
  agent_model=$(python3 -c "import json,os; print(json.load(open(os.environ['HOME']+'/.config/opencode/config.json')).get('model','unknown'))")
else
  agent_model=$AGENT_MODEL
fi

agent_run_id=${AGENT_RUN_ID:-}
human_owner=${HUMAN_OWNER:-}
human_reviewed=${HUMAN_REVIEWED:-unknown}

if [ -z "$human_owner" ]; then
  git_user_name=$(git config --get user.name || true)
  git_user_email=$(git config --get user.email || true)
  if [ -n "$git_user_name" ] && [ -n "$git_user_email" ]; then
    human_owner="$git_user_name <$git_user_email>"
  elif [ -n "$git_user_name" ]; then
    human_owner="$git_user_name"
  elif [ -n "$git_user_email" ]; then
    human_owner="$git_user_email"
  else
    human_owner="unknown"
  fi
fi

if [ "$agent_tool" = "unknown" ]; then
  echo "warning: AGENT_TOOL is not set; using Agent-Tool: unknown" >&2
fi

if [ "$agent_model" = "unknown" ]; then
  echo "warning: AGENT_MODEL is not set; using Agent-Model: unknown" >&2
fi

set -- git commit -m "$message" \
  --trailer "Agent-Tool:$agent_tool" \
  --trailer "Agent-Model:$agent_model" \
  --trailer "Human-Owner:$human_owner" \
  --trailer "Human-Reviewed:$human_reviewed"

if [ -n "$agent_run_id" ]; then
  set -- "$@" --trailer "Agent-Run-Id:$agent_run_id"
fi

"$@"

# Delivery: this repo commits straight to its default branch, so a commit that stays on this
# machine is not delivered. On 2026-10-24 the same template commit sat unpushed in four repos
# for two days because this helper ended at `exec git commit`. Push, verify the remote really
# has the sha, and fail loudly otherwise. Never force-pushes, rebases or resets.
#   AGENT_COMMIT_NO_PUSH=1   commit only (someone else pushes).
sha=$(git rev-parse HEAD)
short=$(printf '%.9s' "$sha")
branch=$(git symbolic-ref --quiet --short HEAD || true)
skip=""
case "${AGENT_COMMIT_NO_PUSH:-}" in 1|true|yes) skip="AGENT_COMMIT_NO_PUSH is set" ;; esac
if [ -z "$skip" ] && { [ "${GITHUB_ACTIONS:-}" = "true" ] || [ "${CI:-}" = "true" ]; }; then skip="CI runner"; fi
if [ -z "$skip" ] && [ -z "$branch" ]; then skip="detached HEAD"; fi
if [ -z "$skip" ] && ! git remote get-url origin >/dev/null 2>&1; then skip="no origin remote"; fi
if [ -n "$skip" ]; then
  echo "not pushed ($skip): $short — deliver it with: git push origin HEAD:<branch>"
  exit 0
fi

if ! git push origin "HEAD:refs/heads/$branch"; then
  {
    echo "error: commit $short was created but NOT PUSHED to origin/$branch."
    echo "       Usual causes: origin moved (git pull --rebase origin $branch, then push), or the"
    echo "       active GitHub account cannot write this repo (gh auth status). Never force-push."
  } >&2
  exit 1
fi
remote=$(git ls-remote origin "refs/heads/$branch" | cut -f1)
if [ "$remote" != "$sha" ]; then
  echo "error: push reported success but origin/$branch is '$remote', not $sha." >&2
  exit 1
fi
echo "delivered: $short is origin/$branch (verified against the remote)"
